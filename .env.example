# ── Required ──────────────────────────────────────────────────────────────────
# MongoDB connection string (attendanceDB).  No default — must be set explicitly.
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/attendanceDB?retryWrites=true&w=majority

# Exact frontend origin(s) allowed for credentialed requests.
# Comma-separate multiple values.  Do NOT use *.
FRONTEND_ORIGIN=https://your-frontend-domain.com

# ── Optional ──────────────────────────────────────────────────────────────────
APP_ENV=production
DATABASE_URL=sqlite:///./timely.db
PORT=8010
